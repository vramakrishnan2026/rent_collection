{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rent-collection",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",

  // Served only at rent-collection.<account>.workers.dev. No per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,

  // The app's pages (public/) are plain files: no build step.
  // Every request goes through the Worker first, so nothing loads before Google sign-in.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // Cloudflare D1 (SQLite). Create it in the dashboard (Storage & Databases > D1)
  // with the name "rent_collection", then paste its Database ID below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rent_collection",
      "database_id": "d7b71d89-7cc4-441b-92df-554ba2558641",
      "migrations_dir": "migrations"
    },
    // The demo copy (Settings > Demo access): a separate database, so a demo sign-in can never
    // reach real tenants. There is no Database ID on purpose: Wrangler (4.45+) creates
    // "rent_collection_demo" on the first deploy and keeps it linked after that.
    // The app builds its tables itself when demo access is turned on (no migrations to run).
    {
      "binding": "DB_DEMO",
      "database_name": "rent_collection_demo"
    }
  ],

  // Cloudflare Workers AI: reads the name off tenant ID photos (free daily allowance).
  "ai": { "binding": "AI" },

  // 9:00 AM India time every day: checks Razorpay for any payment the webhook missed.
  "triggers": { "crons": ["30 3 * * *"] },

  "observability": { "enabled": true }
}
